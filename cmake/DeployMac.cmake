# Materialize Homebrew's external QML links before macdeployqt relocates them.
qt_deploy_qml_imports(TARGET ScanCleaner PLUGINS_FOUND plugins_found)
execute_process(COMMAND "${SCAN_QTPATHS}" --query QT_INSTALL_QML
    OUTPUT_VARIABLE source_qml_root OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
set(installed_qml_root "${QT_DEPLOY_PREFIX}/ScanCleaner.app/Contents/Resources/qml")
file(GLOB_RECURSE source_plugins LIST_DIRECTORIES false "${source_qml_root}/*.dylib")
file(GLOB_RECURSE installed_qml_files LIST_DIRECTORIES false "${installed_qml_root}/*")
foreach(destination IN LISTS installed_qml_files)
    if(IS_SYMLINK "${destination}" AND NOT EXISTS "${destination}")
        file(RELATIVE_PATH relative "${installed_qml_root}" "${destination}")
        if(NOT relative MATCHES "\\.dylib$")
            file(REAL_PATH "${source_qml_root}/${relative}" actual_source)
            if(NOT EXISTS "${actual_source}")
                message(FATAL_ERROR "Missing QML resource: ${relative}")
            endif()
            file(REMOVE "${destination}")
            file(COPY_FILE "${actual_source}" "${destination}")
        endif()
    endif()
endforeach()
foreach(plugin IN LISTS plugins_found)
    set(destination "${QT_DEPLOY_PREFIX}/${plugin}")
    if(IS_SYMLINK "${destination}")
        get_filename_component(plugin_name "${plugin}" NAME)
        foreach(source IN LISTS source_plugins)
            get_filename_component(source_name "${source}" NAME)
            if(source_name STREQUAL plugin_name)
                file(REAL_PATH "${source}" actual_source)
                if(EXISTS "${actual_source}")
                    file(REMOVE "${destination}")
                    file(COPY_FILE "${actual_source}" "${destination}")
                    break()
                endif()
            endif()
        endforeach()
    endif()
    if(NOT EXISTS "${destination}" OR IS_SYMLINK "${destination}")
        message(FATAL_ERROR "Could not materialize QML plugin: ${plugin}")
    endif()
endforeach()
qt_deploy_runtime_dependencies(EXECUTABLE "ScanCleaner.app" ADDITIONAL_MODULES ${plugins_found}
    DEPLOY_TOOL_OPTIONS "-codesign=-" "-no-strip")
execute_process(COMMAND "${SCAN_QTPATHS}" --query QT_INSTALL_PREFIX
    OUTPUT_VARIABLE qt_prefix OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
find_program(SCAN_PYTHON NAMES python3 REQUIRED)
execute_process(COMMAND "${SCAN_PYTHON}" "${CMAKE_CURRENT_LIST_DIR}/../scripts/finalize-macos.py"
    "${QT_DEPLOY_PREFIX}/ScanCleaner.app" --qt-prefix "${qt_prefix}" COMMAND_ERROR_IS_FATAL ANY)
