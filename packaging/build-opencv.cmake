cmake_minimum_required(VERSION 3.24)
if(NOT DEFINED SOURCE OR NOT DEFINED BUILD OR NOT DEFINED PREFIX)
    message(FATAL_ERROR "Pass SOURCE, BUILD, and PREFIX")
endif()
set(platform_options)
if(DEFINED MAC_ARCH)
    list(APPEND platform_options "-DCMAKE_OSX_ARCHITECTURES=${MAC_ARCH}" "-DCMAKE_OSX_DEPLOYMENT_TARGET=12.0")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${SOURCE}" -B "${BUILD}" -G Ninja
    "-DCMAKE_BUILD_TYPE=Release" "-DCMAKE_INSTALL_PREFIX=${PREFIX}"
    -DBUILD_LIST=core,imgproc -DBUILD_SHARED_LIBS=OFF -DBUILD_WITH_STATIC_CRT=OFF
    -DBUILD_TESTS=OFF -DBUILD_PERF_TESTS=OFF -DBUILD_EXAMPLES=OFF -DBUILD_opencv_apps=OFF
    -DWITH_IPP=OFF -DWITH_ITT=OFF -DWITH_ADE=OFF -DWITH_OPENCL=OFF -DWITH_EIGEN=OFF
    -DWITH_LAPACK=OFF -DWITH_CAROTENE=OFF -DWITH_TBB=OFF -DWITH_OPENMP=OFF
    -DWITH_FFMPEG=OFF -DWITH_MSMF=OFF -DWITH_VTK=OFF
    -DWITH_JPEG=OFF -DWITH_TIFF=OFF -DWITH_PNG=OFF -DWITH_WEBP=OFF
    -DWITH_OPENJPEG=OFF -DWITH_JASPER=OFF -DWITH_OPENEXR=OFF
    -DWITH_AVIF=OFF -DWITH_JPEGXL=OFF -DWITH_SPNG=OFF -DWITH_QUIRC=OFF
    -DWITH_PROTOBUF=OFF -DBUILD_PROTOBUF=OFF -DWITH_FLATBUFFERS=OFF
    -DBUILD_opencv_python3=OFF -DBUILD_JAVA=OFF -DBUILD_DOCS=OFF ${platform_options} COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${BUILD}" --parallel 3 COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BUILD}" COMMAND_ERROR_IS_FATAL ANY)
